                  "any"
                ],
                "type": "string"
              },
              "sourcePortList": {
                "description": "At most 1 items.",
                "items": {
                  "type": "string"
                },
                "maxItems": 1,
                "type": "array"
              },
              "sourcePrefixListIds": {
                "description": "Prefix list ids; list_prefix_get_by_name finds one by name and list_prefix_create makes one.",
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "sourcePrefixes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "name": {
            "allOf": [
              {
                "pattern": "^([^ ]([\\s\\S]*[^ ])?)?$"
              }
            ],
            "description": "At most 255 UTF-16 code units. No leading or trailing space.",
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9.@_+\\-% ]*$",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "policy_nat_rule_update"
}
